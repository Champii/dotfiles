# i3 config file (~/.config/i3/config)
# Compatible with i3 version 4.24 - REV 5

#-------------------------------------------------------------------------------
# Variables
#-------------------------------------------------------------------------------
set $mod Mod3
set $term wezterm

# Colors (define all colors used, including bar colors)
set $back                   #1d1F21
set $black                  #282A2E
set $grey                   #373B41
set $lightgrey              #707880
set $white                  #C5C8C6
set $yellow                 #F0C674
set $red                    #cc2925
set $orange                 #ffb86c
set $darkred                #A54242
set $green                  #B5BD56

# Bar Colors
set $bar_bg                 #222222
set $bar_fg                 #dddddd
set $bar_sep                #A54242 # Using original value
set $bar_ws_focused_border  #A54242
set $bar_ws_focused_bg      #A54242
set $bar_ws_focused_text    #ffffff
set $bar_ws_active_border   #333333
set $bar_ws_active_bg       #333333
set $bar_ws_active_text     #ffffff
set $bar_ws_inactive_border #333333
set $bar_ws_inactive_bg     #333333
set $bar_ws_inactive_text   #888888
set $bar_ws_urgent_border   #2f343a
set $bar_ws_urgent_bg       #900000
set $bar_ws_urgent_text     #ffffff
set $bar_binding_mode_border $bar_ws_urgent_border
set $bar_binding_mode_bg    $bar_ws_urgent_bg
set $bar_binding_mode_text  $bar_ws_urgent_text

#-------------------------------------------------------------------------------
# Font & Appearance
#-------------------------------------------------------------------------------
# Font for window titles. Requires a Nerd Font for icons if using complex symbols.
# Adjust font name and size as needed. Using original spec now.
font pango:DejaVu Sans Mono, FontAwesome 8

# Remove obsolete xset lines (modern fontconfig handles this)
# exec xset fp+ $HOME/.fonts/misc
# exec xset fp+ $HOME/.fonts/ohsnap
# exec xset fp+ $HOME/.fonts/terminesspowerline
# exec xset fp rehash

# Default border style for new windows.
default_border pixel 1
default_floating_border pixel 1

# Hide borders adjacent to screen edges smartly (Available in v4.24)
hide_edge_borders smart

# Floating modifier key
floating_modifier $mod

# Gaps (Optional - uncomment and adjust if desired, requires v4.22+)
# gaps inner 5
# gaps outer 5
# smart_gaps on

#-------------------------------------------------------------------------------
# Global Settings
#-------------------------------------------------------------------------------
# Use mouse movements to focus windows
# focus_follows_mouse yes # (Default: yes)

# Don't warp cursor to new windows on focus change
mouse_warping none

# Popups behaviour during fullscreen
popup_during_fullscreen smart # (Default: smart)

# Automatically switch back and forth between workspaces
workspace_auto_back_and_forth yes

# Default orientation for new workspaces (can be horizontal|vertical|auto)
default_orientation horizontal

#-------------------------------------------------------------------------------
# Startup Applications (exec_always runs on restarts too)
#-------------------------------------------------------------------------------
# Screen locker (betterlockscreen)
exec --no-startup-id xautolock -detectsleep -secure -time 30 -locker "betterlockscreen -l blur" \
     -notify 20 -notifier "notify-send -u critical -t 10000 -- 'LOCKING screen in 20 seconds'"

# Wallpaper
exec --no-startup-id feh --bg-scale /usr/share/lightdm-webkit/themes/lightdm-webkit-theme-aether/src/img/wallpapers/space-2.jpg

# Compositor
exec --no-startup-id picom

# Touchpad gestures (if libinput-gestures is installed and configured)
exec --no-startup-id libinput-gestures

# Notification Center (optional, uncomment if used)
# exec --no-startup-id deadd-notification-center

# Launch initial scratchpad terminal (verify title setting for Wezterm)
exec --no-startup-id $term -e zsh -c 'echo -ne "\033]30;scratchpad\007"; zsh'

#-------------------------------------------------------------------------------
# i3bar configuration
#-------------------------------------------------------------------------------
bar {
    i3bar_command i3bar # Add --transparency flag if compositor is running and transparency is desired
    position top
    height 10
    status_command /usr/bin/i3status-rs ~/.i3/status_config.toml

    # Font for the bar. Using original specified size.
    font pango:DejaVu Sans Mono, FontAwesome 6

    # Use powerline separator (ensure FontAwesome 6 font supports this)
    separator_symbol ""

    # Strip 'N:' prefix from workspace names like "1:>_" -> ">_" (Available v4.16+)
    # strip_workspace_numbers yes

    # Use padding instead of height (Available v4.18+)
    # padding 2px 5px # Example: 2px top/bottom, 5px left/right

    # Tray settings
    # tray_output primary # Show tray on primary monitor (default behavior if not set)
    # tray_output none    # Disable tray
    # Padding around tray icons
    tray_padding 2px

    # --- ATTENTION: Colors section corrected - NO inline comments ---
    colors {
        background $bar_bg
        statusline $bar_fg
        separator $bar_sep

        #                            border                  background              text
        focused_workspace            $bar_ws_focused_border  $bar_ws_focused_bg      $bar_ws_focused_text
        active_workspace             $bar_ws_active_border   $bar_ws_active_bg       $bar_ws_active_text
        inactive_workspace           $bar_ws_inactive_border $bar_ws_inactive_bg     $bar_ws_inactive_text
        urgent_workspace             $bar_ws_urgent_border   $bar_ws_urgent_bg       $bar_ws_urgent_text
        binding_mode                 $bar_binding_mode_border $bar_binding_mode_bg   $bar_binding_mode_text
    }
}

#-------------------------------------------------------------------------------
# Modes
#-------------------------------------------------------------------------------
# Resize mode
set $mode_resize Resize: [h]← [j]↓ [k]↑ [l]→ | <kbd>←</kbd><kbd>↓</kbd><kbd>↑</kbd><kbd>→</kbd> | <kbd>Enter</kbd> finish, <kbd>Esc</kbd> cancel
mode "$mode_resize" {
        # resize windows with hjkl or Arrows
        bindsym h resize shrink width 10 px or 1 ppt
        bindsym j resize grow height 10 px or 1 ppt
        bindsym k resize shrink height 10 px or 1 ppt
        bindsym l resize grow width 10 px or 1 ppt

        bindsym Left resize shrink width 10 px or 1 ppt
        bindsym Down resize grow height 10 px or 1 ppt
        bindsym Up resize shrink height 10 px or 1 ppt
        bindsym Right resize grow width 10 px or 1 ppt

        # back to default mode
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default" 
}

#-------------------------------------------------------------------------------
# Keybindings
#-------------------------------------------------------------------------------

# --- Essential System Bindings ---
# Launch terminal
bindsym $mod+Return exec $term
# Alternative terminal launch key (from original config)
bindsym Mod4+Return exec $term

# Kill focused window
bindsym $mod+Shift+q kill

# Application launcher (rofi - install it first!)
bindsym $mod+d exec rofi -show drun -show-icons
# Command runner (rofi)
bindsym $mod+space exec rofi -show run

# Lock screen
bindsym Control+Mod1+l exec betterlockscreen -l blur

# Reload the configuration file
bindsym $mod+Shift+c reload

# Restart i3 inplace (preserves your layout/session)
bindsym $mod+Shift+r restart

# Exit i3 (logs you out of your X session)
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# --- Workspace Navigation & Manipulation ---
# Switch to workspace
bindsym $mod+1 workspace number 1:>_
bindsym $mod+2 workspace number 2:fn
bindsym $mod+3 workspace number 3:www
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number 1:>_
bindsym $mod+Shift+2 move container to workspace number 2:fn
bindsym $mod+Shift+3 move container to workspace number 3:www
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Switch to next/previous workspace
bindsym Ctrl+$mod+l workspace next
bindsym Ctrl+$mod+h workspace prev

# Switch to previously focused workspace (original binding was $mod+Tab for scratchpad show)
# Assign a key if desired, e.g.:
bindsym $mod+Shift+Tab workspace back_and_forth

# --- Window/Container Focus ---
# Focus window using vim keys
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Focus the parent container
bindsym $mod+a focus parent
# Focus the child container
# bindsym $mod+c focus child # Often less useful

# Change focus between tiling / floating windows
bindsym $mod+Shift+t focus mode_toggle

# --- Window/Container Manipulation ---
# Move focused window using Shift+Arrows
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# --- Layout Management ---
# Split in horizontal orientation and spawn a term (Original bindings)
bindsym $mod+x split h, exec $term
# Split in vertical orientation and spawn a term (Original bindings)
bindsym $mod+z split v, exec $term

# Change split orientation *only* (Original bindings)
bindsym $mod+Shift+x split h
bindsym $mod+Shift+z split v

# Change container layout
bindsym $mod+Shift+A layout stacking    # Stack layout (using Shift+A)
bindsym $mod+w layout tabbed      # Tabbed layout
bindsym $mod+e layout toggle split # Toggle splith/splitv

# Enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# Toggle tiling/floating
bindsym $mod+Shift+space floating toggle

# --- Resizing Windows ---
# Enter resize mode
bindsym $mod+r mode "$mode_resize"
# Old bindings (commented out as resize mode is preferred):
# bindsym $mod+Mod1+h resize shrink width 10 px or 1 ppt
# bindsym $mod+Mod1+j resize grow height 10 px or 1 ppt
# bindsym $mod+Mod1+k resize shrink height 10 px or 1 ppt
# bindsym $mod+Mod1+l resize grow width 10 px or 1 ppt

# --- Scratchpad ---
# Move the focused window to the scratchpad
bindsym $mod+Shift+s move scratchpad

# Show the last hidden scratchpad window (toggle) - Original binding
bindsym $mod+Tab scratchpad show

# Show specific scratchpad applications (match on instance/class/title)
# $mod+s is now free if $mod+Shift+A is used for stacking, or keep original:
bindsym $mod+s [instance="auryo"] scratchpad show
bindsym $mod+m [instance="rambox"] scratchpad show

# --- Application Shortcuts ---
# Use raiseorlaunch script
bindsym $mod+b exec --no-startup-id raiseorlaunch -s brave
bindsym $mod+p exec --no-startup-id raiseorlaunch -s scrcpy
bindsym $mod+Shift+v exec --no-startup-id raiseorlaunch -s vlc

# Other app launchers
bindsym $mod+Shift+b exec qutebrowser
bindsym $mod+n exec emacsclient -c

# Screenshot (flameshot)
bindsym Print exec flameshot gui

# --- Marks (vim-like Gotos) ---
# Create a mark (prompt for 1 char)
bindsym $mod+Shift+m exec i3-input -F 'mark %s' -l 1 -P 'Mark: '

# Jump to a mark (prompt for 1 char)
bindsym $mod+g exec i3-input -F '[con_mark="%s"] focus' -l 1 -P 'Goto: '

# --- Media Keys ---
# Volume control (using @DEFAULT_SINK@ for pactl - requires recent pactl version)
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle

# Player control (requires playerctl)
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

# --- Brightness Keys ---
# Requires xbacklight or similar tool
bindsym XF86MonBrightnessUp exec --no-startup-id xbacklight -inc 5
bindsym XF86MonBrightnessDown exec --no-startup-id xbacklight -dec 5

bindsym Shift+XF86MonBrightnessUp exec --no-startup-id xbacklight -set 100
bindsym Shift+XF86MonBrightnessDown exec --no-startup-id xbacklight -set 1

#-------------------------------------------------------------------------------
# Window Rules (Floating, Assignments)
#-------------------------------------------------------------------------------

# --- Floating Windows ---
for_window [window_role="alert"] floating enable
for_window [class="(?i)clickui.py"] floating enable
for_window [title="Emacs Everywhere"] floating enable # If using this package

# Rule for the floating launcher terminal (if using the fzf method)
for_window [title="~ : i3-dmenu-deskto"] floating enable

# Zoom Rules (VERIFY WITH XPROP! Class/role/type might differ on your system)
for_window [class="(?i)zoom" window_type="dialog"] floating enable
for_window [class="(?i)zoom" window_role="(?i)(settings|meeting settings)"] floating enable # Combine settings roles

# --- Workspace Assignments ---
# Use '→ number N' syntax (Available v4.18+)
assign [title="^first"] → number 1
assign [class="(?i)emacs"] → number 2
assign [class="(?i)brave-browser"] → number 3

#-------------------------------------------------------------------------------
# Colors (Client Decorations) - Uses variables defined at top
#-------------------------------------------------------------------------------
# class                 border  backgr. text    indicator child_border
client.focused          $red    $lightgrey $black  $red      $lightgrey
client.focused_inactive $grey   $grey      $lightgrey $grey     $grey
client.unfocused        $grey   $black     $lightgrey $grey     $black
client.urgent           $red    $darkred   $white     $red      $darkred
client.placeholder      $black  $black     $white     $black    $black
client.background       $back

# End of i3 config file - v4.24 Compatible

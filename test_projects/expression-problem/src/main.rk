// Test 1: Original case - inline dot in argument
test1 = ->
    a
        .lol
        .mdr toto.tata
        .haha

// Test 2: Multiline arguments in method chain
test2 = ->
    foo
        .bar
            arg1
            arg2
        .baz

// Test 3: Inline arguments with dots
test3 = ->
    foo
        .bar arg1.field1, arg2.field2
        .baz

// Test 4: Nested method chains in arguments
test4 = ->
    foo
        .bar arg1.method1.method2
        .baz

// Test 5: Complex multiline with nested dots
test5 = ->
    obj
        .process
            data.field1.field2
            config.setting
        .finalize

main = ->
    test1
    test2
    test3
    test4
    test5

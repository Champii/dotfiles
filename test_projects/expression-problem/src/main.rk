struct Point
    x: Int
    y: Int
    z: Int = 0

struct Container T
    value: T
    count: Int

enum Result T, E
    Ok T
    Err E


trait Display
    display: () -> String

impl Display for Point
    display = ->
        "Point"

main = ->
    tuple_val = (
        1 + 2 * 3,
        "nested",
        (4, 5, (6, 7))
    )

extern free : Ptr T -> ()

struct Lol
  mdr: Tata

main : () -> ()
main = x -> x

trait Num
  + : T -> T -> T

impl Num Int
  + = a, b -> %IAdd a b

main = -> (0, "a")

toto = ->
  a = 2
  (a, b) = (1, 2)
  Result::Ok a = lol
  match a
    a -> 2
    (a, 2) -> a + b
    [lol, ..mdr] -> 0
    _ -> 0


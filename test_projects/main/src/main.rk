mod mdr #lol

extern free : Ptr T -> ()
type Lol T = Toto T -> (T -> U) -> U

struct Lol
  < mdr : Tata

main : () -> ()
main = x -> x

+ = a, b -> a + b

trait Num
  + : T -> T -> T

impl Num Int
  + = a, b -> %IAdd a, b

struct Lol
  mdr : Tata
  pas_mdr : Toto

main = -> (0, "a")

toto = ->
  main!

  a = 2

  (a, b) = (1, 2)

  Result::Ok a = lol
  a: Mdr -> Toto A = mdr (toto : Int) : String


struct MyStruct
    field : Int
    toto: Lol

enum MyEnum
    Foo Bar
    Ba

impl Lol
    @toto = -> @lol

main = ->
    a += 2

    2

enum Either T, U
    Left T
    Right U

impl Either T, U
    @map = f -> match @
        Left x => Left f x
        Right x => Right f x

    @left = -> match @
        Left x => x
        Right x => panic "Not left"

    @right = -> match @
        Left x => panic "lol"
        Right x => x

main = ->
    match lol
        Foo => 2
        Bar => 3
        Ba => 4
    match lol
        Left x => panic "Not left"
        Right x => x
    lol

